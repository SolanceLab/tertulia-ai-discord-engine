      "properties": {
        "server_id": {
          "type": "string",
          "description": "The Discord server (guild) ID. Must be the home server."
        },
        "action": {
          "type": "string",
          "description": "Optional: only this action, by Discord name, for example MemberKick, MemberBanAdd, MessageDelete, RoleUpdate, ChannelCreate"
        },
        "user_id": {
          "type": "string",
          "description": "Optional: only actions done by this user ID"
        },
        "limit": {
          "type": "number",
          "description": "Number of entries to return (max 50, default 25)"
        }
      },
      "required": [
        "server_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
