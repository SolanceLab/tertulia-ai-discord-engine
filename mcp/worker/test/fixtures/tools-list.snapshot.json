        "title",
        "content"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "discord_create_poll",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "description": "The channel ID to create the poll in"
        },
        "question": {
          "type": "string",
          "description": "The poll question"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "Option text"
              },
              "emoji": {
                "type": "string",
                "description": "Optional emoji for this option"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 10,
          "description": "Poll options (2 to 10), each an object with text and an optional emoji"
        },
        "duration_hours": {
          "type": "number",
          "description": "How long the poll runs in hours (1-768, default 24)"
        },
        "allow_multiselect": {
          "type": "boolean",
          "description": "Allow users to select multiple options (default false)"
        }
      },
      "required": [
        "channel_id",
        "question",
        "options"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "discord_create_role",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "The Discord server (guild) ID. Must be House of Solance"
        },
        "name": {
          "type": "string",
          "description": "The new role name"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional: Discord permission names to grant, e.g. ViewChannel, SendMessages, ManageMessages"
        },
        "color": {
          "type": "string",
          "description": "Optional: hex color, e.g. #5865F2"
        },
        "hoist": {
          "type": "boolean",
          "description": "Optional: show members with this role separately in the member list"
        },
        "mentionable": {
          "type": "boolean",
          "description": "Optional: allow anyone to @mention this role"
        },
        "reason": {
          "type": "string",
          "description": "Optional: Reason for creating the role, kept in the audit log"
        }
      },
      "required": [
        "server_id",
        "name"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
