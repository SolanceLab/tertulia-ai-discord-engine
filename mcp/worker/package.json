{
  "name": "discord-mcp-cloud",
  "version": "1.0.0",
  "description": "Remote MCP server for Discord on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test 'test/*.test.mjs'",
    "typecheck": "tsc --noEmit",
    "deploy": "WRANGLER_SEND_METRICS=false npx wrangler deploy --var GIT_SHA:$(git rev-parse --short HEAD)"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "hono": "4.13.18",
    "@hono/node-server": "2.1.7"
  }
}
