  {
    "name": "discord_send_file",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "description": "The Discord channel ID to send to"
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "description": "The filename to use for the attachment"
        },
        "file_data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 9500000,
          "description": "Base64-encoded file data"
        },
        "content": {
          "type": "string",
          "description": "Optional message text to accompany the file"
        }
      },
      "required": [
        "channel_id",
        "file_name",
        "file_data"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "discord_send_message",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "description": "The Discord channel ID to send to"
        },
        "content": {
          "type": "string",
          "description": "The message content to send (max 2000 characters). Optional when sticker_ids or embeds is provided."
        },
        "reply_to_message_id": {
          "type": "string",
          "description": "Optional message ID to reply to. Creates a threaded reply linking to the original message."
        },
        "sticker_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "description": "Optional array of guild sticker IDs (max 3) to send with the message, all in one Discord message. When provided, content is not required. Look IDs up with discord_list_stickers."
        },
        "embeds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Body text; markdown links work here"
              },
              "url": {
                "type": "string",
                "description": "Makes the title a link (http or https)"
              },
              "color": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "Hex string like #c9a24b, or an integer"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "footer": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "icon_url": {
                    "type": "string"
                  },
                  "proxy_icon_url": {
                    "type": "string",
                    "description": "Read-only; ignored when sending"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              "author": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "icon_url": {
                    "type": "string"
                  },
                  "proxy_icon_url": {
                    "type": "string",
                    "description": "Read-only; ignored when sending"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "image_url": {
                "type": "string"
              },
              "image_proxy_url": {
                "type": "string",
                "description": "Read-only; ignored when sending"
              },
              "thumbnail_url": {
                "type": "string"
              },
              "thumbnail_proxy_url": {
                "type": "string",
                "description": "Read-only; ignored when sending"
              },
              "timestamp": {
                "type": "string",
                "description": "ISO date"
              }
            },
            "additionalProperties": false
          },
          "description": "Optional embeds (max 10; title 256, description 4096, 25 fields, 6000 characters in all). Same shape discord_read_messages returns. When provided, content is not required."
        }
      },
      "required": [
        "channel_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "discord_set_channel_permission",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "The Discord server (guild) ID. Must be House of Solance"
        },
        "channel_id": {
          "type": "string",
          "description": "The channel or category ID"
        },
        "target_id": {
          "type": "string",
          "description": "The role ID or member user ID this overwrite applies to"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "role",
            "member"
          ],
          "description": "Whether target_id is a role or a member"
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional: Discord permission names to allow, e.g. ViewChannel"
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional: Discord permission names to deny"
        },
        "neutral": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional: Discord permission names to unset (back to inherit)"
        },
        "clear": {
          "type": "boolean",
          "description": "Optional: remove the whole overwrite for this target instead of editing it"
        },
        "reason": {
          "type": "string",
          "description": "Optional: Reason for the change, kept in the audit log"
        }
      },
      "required": [
        "server_id",
        "channel_id",
        "target_id",
        "target_type"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "discord_set_channel_topic",
