  {
    "name": "discord_view_attachment",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "description": "The channel ID where the message is"
        },
        "message_id": {
          "type": "string",
          "description": "The message ID carrying the image"
        },
        "filename": {
          "type": "string",
          "maxLength": 255,
          "description": "Which image to view when the message has more than one. Omit for the first."
        }
      },
      "required": [
        "channel_id",
        "message_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
