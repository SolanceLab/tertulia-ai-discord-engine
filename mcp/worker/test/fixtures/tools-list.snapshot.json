  {
    "name": "discord_edit_message",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "description": "The channel ID containing the message"
        },
        "message_id": {
          "type": "string",
          "description": "The message ID to edit"
        },
        "new_content": {
          "type": "string",
          "description": "New message content. Optional when embeds is given."
        },
        "embeds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Body text; markdown links work here"
              },
              "url": {
                "type": "string",
                "description": "Makes the title a link (http or https)"
              },
              "color": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "Hex string like #c9a24b, or an integer"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "footer": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "icon_url": {
                    "type": "string"
                  },
                  "proxy_icon_url": {
                    "type": "string",
                    "description": "Read-only; ignored when sending"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              "author": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "icon_url": {
                    "type": "string"
                  },
                  "proxy_icon_url": {
                    "type": "string",
                    "description": "Read-only; ignored when sending"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "image_url": {
                "type": "string"
              },
              "image_proxy_url": {
                "type": "string",
                "description": "Read-only; ignored when sending"
              },
              "thumbnail_url": {
                "type": "string"
              },
              "thumbnail_proxy_url": {
                "type": "string",
                "description": "Read-only; ignored when sending"
              },
              "timestamp": {
                "type": "string",
                "description": "ISO date"
              }
            },
            "additionalProperties": false
          },
          "description": "New embeds, replacing the old ones (max 10; same shape discord_read_messages returns). [] removes every embed."
        }
      },
      "required": [
        "channel_id",
        "message_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
