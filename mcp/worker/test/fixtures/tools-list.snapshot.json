      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "discord_search_messages",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "description": "The Discord channel ID to search"
        },
        "author_id": {
          "type": "string",
          "description": "Filter by author's Discord user ID"
        },
        "keyword": {
          "type": "string",
          "description": "Case-insensitive text search in message content"
        },
        "before": {
          "type": "string",
          "description": "ISO timestamp — only messages before this date"
        },
        "after": {
          "type": "string",
          "description": "ISO timestamp — only messages after this date"
        },
        "has_attachment": {
          "type": "boolean",
          "description": "Filter for messages with (true) or without (false) attachments"
        },
        "limit": {
          "type": "number",
          "description": "Max results to return (default 20, max 50)"
        },
        "scan_depth": {
          "type": "number",
          "description": "Messages to scan internally (default 200, max 500)"
        }
      },
      "required": [
        "channel_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "discord_send_dm",
    "inputSchema": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
